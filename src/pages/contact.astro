---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch with the RSE CEP team">
  <h1>Contact</h1>
  <p>
    The RSE Capacity Enhancement Project is based at the HASS Digital Research Hub,
    Australian National University.
  </p>

  <dl class="contact-list">
    <div>
      <dt>Email</dt>
      <dd><a href="mailto:hdrh@anu.edu.au">hdrh@anu.edu.au</a></dd>
    </div>
    <div>
      <dt>Web</dt>
      <dd><a href="https://hdrh.anu.edu.au/about-us/how-we-work">hdrh.anu.edu.au</a></dd>
    </div>
    <div>
      <dt>LinkedIn</dt>
      <dd><a href="https://www.linkedin.com/company/anu-hass-digital-research-hub/">ANU HASS Digital Research Hub</a></dd>
    </div>
    <div>
      <dt>Address</dt>
      <dd>
        Room 2.14, Beryl Rawson Building<br />
        13 Ellery Crescent<br />
        Australian National University<br />
        ACT 2601, Australia
      </dd>
    </div>
  </dl>
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  gsap.from('h1', { opacity: 0, y: 24, duration: 0.6, ease: 'power2.out' });
  gsap.from('.contact-list div', {
    scrollTrigger: { trigger: '.contact-list', start: 'top 82%' },
    opacity: 0, y: 16, duration: 0.45, stagger: 0.07, ease: 'power2.out',
  });
</script>

<style>
  .contact-list {
    margin: 2rem 0 0;
    display: grid;
    gap: 1.25rem;
  }

  .contact-list div {
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 0.5rem;
    align-items: baseline;
  }

  dt {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  dd {
    margin: 0;
    line-height: 1.6;
  }
</style>
