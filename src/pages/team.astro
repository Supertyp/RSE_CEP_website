---
import BaseLayout from '../layouts/BaseLayout.astro';

const team = [
  {
    name: 'James Smithies',
    role: 'Founding Director · HASS Digital Research Hub, Australian National University',
    bio: 'A historian from New Zealand and Founding Director of the HASS Digital Research Hub at ANU, James previously served as Professor of Digital Humanities at King\'s College London where he founded King\'s Digital Lab. His work focuses on digital humanities research infrastructure, and he currently leads ARDC-funded research software engineering initiatives including exploration of large language models for historical research.',
  },
  {
    name: 'Wolfgang Barth',
    role: 'Research Software Engineer (RSE-CEP) · Australian National University',
    bio: 'Wolfgang works to connect research communities with technical development, focusing on language documentation and data infrastructure projects. He collaborates with Indigenous communities, data stewards, and IT teams to create solutions following FAIR and CARE principles. In the RSE Capacity Enhancement Project, he aims to enhance research software engineering skills across HASS and the Indigenous research sector by developing accessible guidance, standards, and patterns.',
  },
  {
    name: 'Mat Bettinson',
    role: 'Principal Research Software Engineer · HASS Digital Research Hub, Australian National University',
    bio: 'Mat brings experience spanning videogame development, linguistics research, and large-scale digital infrastructure, including a PhD on socio-technical solutions for endangered language speakers and postdoctoral work with Indigenous communities in Arnhem Land. He previously served as technical lead for the Digital Observatory at QUT, overseeing data collection platforms and research infrastructure. At ANU he leads the engineering team delivering digital methods support for the humanities and social sciences.',
  },
  {
    name: 'Junran Lei',
    role: 'Senior Research Software Engineer · HASS Digital Research Hub, Australian National University',
    bio: 'Junran\'s work bridges digital humanities, social science research, and research software engineering, with expertise in machine learning, optical character recognition, geospatial mapping, and archival systems. She has a particular focus on Indigenous and historical archives, and her projects span data visualisation, mobile applications, and semantic web technologies. She is co-chair of the Research Software Asia Australia Conference.',
  },
  {
    name: 'Peter Sefton',
    role: 'Research Software Engineer · Australian National University',
    bio: '',
  },
  {
    name: 'Louise Pert',
    role: 'Hub Administrator · HASS Digital Research Hub, Australian National University',
    bio: '',
  },
];
---

<BaseLayout title="Team" description="Meet the RSE CEP team">
  <h1>Team</h1>
  <p>The RSE CEP project is carried out by the following team members.</p>

  <ul class="team-grid">
    {team.map((member) => (
      <li class="member-card">
        <div class="member-name">{member.name}</div>
        <div class="member-role">{member.role}</div>
        {member.bio && <p class="member-bio">{member.bio}</p>}
      </li>
    ))}
  </ul>
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Page header
  gsap.from('h1', { opacity: 0, y: 24, duration: 0.6, ease: 'power2.out' });

  // Team cards stagger in
  gsap.from('.member-card', {
    scrollTrigger: { trigger: '.team-grid', start: 'top 82%' },
    opacity: 0, y: 20, duration: 0.5, stagger: 0.08, ease: 'power2.out',
  });
</script>

<style>
  .team-grid {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .member-card {
    border-top: 3px solid var(--color-accent);
    padding-top: 1rem;
  }

  .member-name {
    font-weight: 600;
    font-size: 1.05rem;
    margin-bottom: 0.2rem;
  }

  .member-role {
    color: var(--color-muted);
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  .member-bio {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
