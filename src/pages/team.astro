---
import BaseLayout from '../layouts/BaseLayout.astro';

const team = [
  {
    name: 'Peter Sefton',
    role: 'Research Software Engineer · Australian National University',
  },
  {
    name: 'James Smithies',
    role: 'Professor of Digital Humanities & Director · Australian National University',
  },
  {
    name: 'Mat Bettinson',
    role: 'Principal Research Software Engineer · Australian National University',
  },
  {
    name: 'Junran Lei',
    role: 'Senior Research Software Engineer · Australian National University',
  },
  {
    name: 'Wolfgang Barth',
    role: 'Research Software Engineer (RSE-CEP) · Australian National University',
  },
  {
    name: 'Loise Pert',
    role: 'Project Manager · Australian National University',
  },
];
---

<BaseLayout title="Team" description="Meet the RSE CEP team">
  <h1>Team</h1>
  <p>The RSE CEP project is carried out by the following team members.</p>

  <ul class="team-list">
    {team.map((member) => (
      <li class="member">
        <div class="member-name">{member.name}</div>
        <div class="member-role">{member.role}</div>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .team-list {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    gap: 1.5rem;
  }

  .member {
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;
  }

  .member-name {
    font-weight: 600;
    font-size: 1.05rem;
  }

  .member-role {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin: 0.2rem 0 0;
  }
</style>
