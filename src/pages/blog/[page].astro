---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const PAGE_SIZE = 5;

export async function getStaticPaths() {
  const PAGE_SIZE = 5;
  const allPosts = (await getCollection('blog'))
    .sort((a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => {
    const page = i + 2;
    const start = (page - 1) * PAGE_SIZE;
    return {
      params: { page: String(page) },
      props: {
        posts: allPosts.slice(start, start + PAGE_SIZE),
        currentPage: page,
        totalPages,
      },
    };
  });
}

const { posts, currentPage, totalPages } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title={`Blog — Page ${currentPage}`} description="News and updates from the RSE CEP project">
  <h1>Blog <span class="page-label">— Page {currentPage}</span></h1>

  <ul class="post-list">
    {posts.map((post: any) => (
      <li>
        <a href={`${base}blog/${post.id}/`} class="post-title">{post.data.title}</a>
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <p class="post-desc">{post.data.description}</p>
      </li>
    ))}
  </ul>

  <nav class="pagination">
    <div>
      {currentPage > 2 && <a href={`${base}blog/${currentPage - 1}/`}>← Newer posts</a>}
      {currentPage === 2 && <a href={`${base}blog/`}>← Newer posts</a>}
    </div>
    <span class="pagination-current">Page {currentPage} of {totalPages}</span>
    <div>
      {currentPage < totalPages && <a href={`${base}blog/${currentPage + 1}/`}>Older posts →</a>}
    </div>
  </nav>
</BaseLayout>

<style>
  .page-label {
    font-weight: 400;
    color: var(--color-muted);
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }

  .post-list li {
    border-top: 1px solid var(--color-border);
    padding: 1.5rem 0;
  }

  .post-title {
    display: block;
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }

  .post-desc {
    margin: 0.5rem 0 0;
    color: var(--color-muted);
  }

  .pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
    margin-top: 0.5rem;
  }

  .pagination-current {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
</style>
