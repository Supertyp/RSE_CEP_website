---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Blog" description="News and updates from the RSE CEP project">
  <h1>Blog</h1>

  {posts.length === 0 ? (
    <p>No posts yet.</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`${base}blog/${post.id}/`} class="post-title">{post.data.title}</a>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <p class="post-desc">{post.data.description}</p>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    gap: 0;
  }

  .post-list li {
    border-top: 1px solid var(--color-border);
    padding: 1.5rem 0;
  }

  .post-title {
    display: block;
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }

  .post-desc {
    margin: 0.5rem 0 0;
    color: var(--color-muted);
  }
</style>
