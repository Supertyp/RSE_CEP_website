---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const PAGE_SIZE = 5;

const allPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const posts = allPosts.slice(0, PAGE_SIZE);
const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title="Blog" description="News and updates from the RSE CEP project">
  <Fragment slot="head">
    <link rel="stylesheet" href={`${base}pagefind/pagefind-ui.css`} />
  </Fragment>

  <h1>Blog</h1>

  <div id="search" class="search-box"></div>

  {posts.length === 0 ? (
    <p>No posts yet.</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`${base}blog/${post.id}/`} class="post-title">{post.data.title}</a>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <p class="post-desc">{post.data.description}</p>
        </li>
      ))}
    </ul>
  )}

  {totalPages > 1 && (
    <nav class="pagination">
      <span class="pagination-current">Page 1 of {totalPages}</span>
      <a href={`${base}blog/2/`}>Older posts →</a>
    </nav>
  )}
</BaseLayout>

<script is:inline define:vars={{ pagefindBase: base }}>
  window.addEventListener('DOMContentLoaded', function () {
    var script = document.createElement('script');
    script.src = pagefindBase + 'pagefind/pagefind-ui.js';
    script.onload = function () {
      new PagefindUI({ element: '#search', showImages: false });
    };
    document.head.appendChild(script);
  });
</script>

<style>
  .search-box {
    margin-bottom: 2rem;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-list li {
    border-top: 1px solid var(--color-border);
    padding: 1.5rem 0;
  }

  .post-title {
    display: block;
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }

  .post-desc {
    margin: 0.5rem 0 0;
    color: var(--color-muted);
  }

  .pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
    margin-top: 0.5rem;
  }

  .pagination-current {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
</style>
