---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const allPatterns = await getCollection('patterns');

const typeOrder = ['architectural', 'implementation', 'design', 'process'];
const typeLabels: Record<string, string> = {
  architectural: 'Architectural',
  implementation: 'Implementation',
  design: 'Design',
  process: 'Process',
};

const grouped = typeOrder
  .map((type) => ({
    type,
    label: typeLabels[type],
    patterns: allPatterns
      .filter((p) => p.data.pattern_type === type)
      .sort((a, b) => a.data.pattern_id.localeCompare(b.data.pattern_id)),
  }))
  .filter((g) => g.patterns.length > 0);
---

<BaseLayout title="Patterns" description="RSE patterns for HASS and Indigenous research software engineering">
  <Fragment slot="head">
    <link rel="stylesheet" href={`${base}pagefind/pagefind-ui.css`} />
  </Fragment>

  <div class="page-title-row">
    <h1>Patterns</h1>
    <a href={`${base}patterns/rss.xml`} class="rss-link" title="Subscribe via RSS" aria-label="Subscribe to patterns RSS feed"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="6.18" cy="17.82" r="2.18"/><path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"/></svg></a>
  </div>
  <div id="search" class="search-box"></div>
  <p>
    Practical solutions to recurring problems in research software engineering for the humanities,
    arts, social sciences, and Indigenous research contexts. Patterns are classified into four types:
    <strong>Architectural</strong> (system structure and data governance),
    <strong>Implementation</strong> (specific technologies and techniques),
    <strong>Design</strong> (artefact behaviour and interaction),
    and <strong>Process</strong> (workflows and stakeholder engagement).
  </p>

  {grouped.map(({ label, patterns }) => (
    <section class="pattern-group">
      <h2>{label}</h2>
      <ul class="pattern-list">
        {patterns.map((p) => (
          <li class="pattern-card">
            <a href={`${base}patterns/${p.id}/`} class="pattern-link">
              <span class="pattern-id">{p.data.pattern_id}</span>
              <span class="pattern-title">{p.data.title}</span>
            </a>
            <div class="pattern-meta">
              {p.data.keywords.slice(0, 5).map((kw: string) => (
                <span class="tag">{kw}</span>
              ))}
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

<script is:inline define:vars={{ pagefindBase: base }}>
  window.addEventListener('DOMContentLoaded', function () {
    var script = document.createElement('script');
    script.src = pagefindBase + 'pagefind/pagefind-ui.js';
    script.onload = function () {
      new PagefindUI({ element: '#search', showImages: false });
    };
    document.head.appendChild(script);
  });
</script>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Page header
  const tl = gsap.timeline({ defaults: { ease: 'power2.out' } });
  tl.from('h1', { opacity: 0, y: 24, duration: 0.6 })
    .from('p',  { opacity: 0, y: 16, duration: 0.5 }, '-=0.35');

  // Each pattern group fades in as it enters the viewport
  gsap.utils.toArray<Element>('.pattern-group').forEach((group) => {
    gsap.from(group.querySelectorAll('.pattern-card'), {
      scrollTrigger: { trigger: group, start: 'top 82%' },
      opacity: 0, y: 14, duration: 0.38, stagger: 0.07, ease: 'power2.out',
    });
  });
</script>

<style>
  .page-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0;
  }

  .rss-link {
    display: inline-flex;
    align-items: center;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.25rem 0.4rem;
    text-decoration: none;
    flex-shrink: 0;
    line-height: 1;
  }

  .rss-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    text-decoration: none;
  }

  .search-box {
    margin-bottom: 2rem;
  }

  .pattern-group {
    margin-top: 2.5rem;
  }

  .pattern-group h2 {
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }

  .pattern-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
  }

  .pattern-card {
    border-top: 1px solid var(--color-border);
    padding: 0.9rem 0;
  }

  .pattern-card:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .pattern-link {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    color: var(--color-text);
    font-weight: 500;
    text-decoration: none;
  }

  .pattern-link:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .pattern-id {
    font-size: 0.8rem;
    font-family: monospace;
    color: var(--color-muted);
    flex-shrink: 0;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 0.1em 0.4em;
  }

  .pattern-meta {
    margin-top: 0.4rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag {
    font-size: 0.75rem;
    color: var(--color-muted);
    background: var(--color-border);
    border-radius: 3px;
    padding: 0.1em 0.4em;
  }
</style>
