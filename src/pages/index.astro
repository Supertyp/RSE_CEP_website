---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const patterns = (await getCollection('patterns'))
  .sort((a, b) => a.data.pattern_id.localeCompare(b.data.pattern_id))
  .slice(0, 6);

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title="Home" description="Research Software Engineering Capacity Enhancement Project">
  <section class="hero">
    <h1>RSE Capacity Enhancement Project</h1>
    <p class="lead">
      Practical guidance and patterns for research software engineering in the humanities,
      arts, social sciences, and Indigenous research contexts.
    </p>
    <a href={`${base}patterns/`} class="cta">Browse patterns →</a>
  </section>

  <section class="about">
    <h2>About the project</h2>
    <p>
      The RSE CEP is an <a href="https://ardc.edu.au/">ARDC</a>-funded initiative based at the
      <a href="https://hdrh.anu.edu.au/">HASS Digital Research Hub, ANU</a>. We develop skills,
      resources, and infrastructure that support high-quality research software practice across
      HASS and Indigenous research communities.
    </p>
    <p>
      Our patterns library captures proven solutions to recurring engineering challenges — from
      data governance and Indigenous data sovereignty to software architecture and research workflows.
    </p>
    <a href={`${base}team/`} class="link-muted">Meet the team →</a>
  </section>

  {patterns.length > 0 && (
    <section class="patterns-section">
      <div class="section-header">
        <h2>Patterns</h2>
        <a href={`${base}patterns/`} class="link-muted">View all →</a>
      </div>
      <ul class="pattern-list">
        {patterns.map((p) => (
          <li class="pattern-item">
            <a href={`${base}patterns/${p.id}/`} class="pattern-link">
              <span class="pattern-id">{p.data.pattern_id}</span>
              <span class="pattern-title">{p.data.title}</span>
            </a>
            <span class="pattern-type">{p.data.pattern_type}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {posts.length > 0 && (
    <section class="blog-section">
      <div class="section-header">
        <h2>Blog</h2>
        <a href={`${base}blog/`} class="link-muted">All posts →</a>
      </div>
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`${base}blog/${post.id}/`}>{post.data.title}</a>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Hero — staggered load animation
  const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
  tl.from('.hero h1',   { opacity: 0, y: 32, duration: 0.7 })
    .from('.hero .lead', { opacity: 0, y: 20, duration: 0.55 }, '-=0.4')
    .from('.hero .cta',  { opacity: 0, y: 14, duration: 0.4 }, '-=0.3');

  // About section — scroll reveal
  gsap.from('.about', {
    scrollTrigger: { trigger: '.about', start: 'top 82%' },
    opacity: 0, y: 22, duration: 0.55, ease: 'power2.out',
  });

  // Patterns preview — stagger each row
  gsap.from('.pattern-item', {
    scrollTrigger: { trigger: '.patterns-section', start: 'top 80%' },
    opacity: 0, y: 14, duration: 0.4, stagger: 0.07, ease: 'power2.out',
  });

  // Blog list — stagger each post
  gsap.from('.post-list li', {
    scrollTrigger: { trigger: '.blog-section', start: 'top 80%' },
    opacity: 0, y: 12, duration: 0.35, stagger: 0.09, ease: 'power2.out',
  });
</script>

<style>
  .hero {
    padding: 2rem 0 3rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 3rem;
  }

  .hero h1 {
    font-size: 2.25rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }

  .lead {
    font-size: 1.15rem;
    color: var(--color-muted);
    max-width: 560px;
    margin-bottom: 1.5rem;
  }

  .cta {
    display: inline-block;
    background: var(--color-accent);
    color: #fff;
    padding: 0.55rem 1.25rem;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .cta:hover {
    opacity: 0.88;
    text-decoration: none;
  }

  .about {
    margin-bottom: 3rem;
  }

  .about h2 {
    font-size: 1.1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }

  .link-muted {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .link-muted:hover {
    color: var(--color-accent);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .section-header h2 {
    font-size: 1.1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin-bottom: 0;
  }

  .patterns-section {
    margin-bottom: 3rem;
  }

  .pattern-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .pattern-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--color-border);
  }

  .pattern-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .pattern-link {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    color: var(--color-text);
    font-weight: 500;
    text-decoration: none;
    flex: 1;
    min-width: 0;
  }

  .pattern-link:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .pattern-id {
    font-size: 0.75rem;
    font-family: monospace;
    color: var(--color-muted);
    flex-shrink: 0;
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 0.1em 0.4em;
  }

  .pattern-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pattern-type {
    font-size: 0.75rem;
    color: var(--color-muted);
    text-transform: capitalize;
    flex-shrink: 0;
  }

  .blog-section {
    margin-bottom: 1rem;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--color-border);
  }

  .post-list li:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .post-list a {
    color: var(--color-text);
    font-weight: 500;
  }

  .post-list a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .hero h1 {
      font-size: 1.75rem;
    }

    .pattern-item {
      flex-wrap: wrap;
    }

    .pattern-type {
      display: none;
    }

    .post-list li {
      flex-direction: column;
      gap: 0.2rem;
    }
  }
</style>
