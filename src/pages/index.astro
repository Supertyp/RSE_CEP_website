---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title="Home" description="Research Software Engineering Capacity Enhancement Project">
  <section class="hero">
    <h1>RSE Capacity Enhancement Project</h1>
    <p class="lead">
      Building research software engineering capacity across institutions — through training,
      community development, and knowledge sharing.
    </p>
  </section>

  <hr />

  <section>
    <h2>About the Project</h2>
    <p>
      The Research Software Engineering Capacity Enhancement Project (RSE CEP) aims to strengthen
      the research software engineering community by developing skills, resources, and infrastructure
      that support high-quality research software practice.
    </p>
    <p>
      The project produces training materials, publishes best-practice guides, and works with
      research institutions to embed sustainable RSE capacity where it is needed most.
    </p>
  </section>

  {posts.length > 0 && (
    <section>
      <h2>Latest from the Blog</h2>
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`${base}blog/${post.id}/`}>{post.data.title}</a>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </li>
        ))}
      </ul>
      <p><a href={`${base}blog/`}>All posts →</a></p>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    margin-bottom: 2rem;
  }

  .hero h1 {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .lead {
    font-size: 1.15rem;
    color: var(--color-muted);
    max-width: 600px;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
  }

  .post-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .post-list li:first-child {
    border-top: 1px solid var(--color-border);
  }
</style>
