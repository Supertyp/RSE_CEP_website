---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Research Software Engineering Capacity Enhancement Project' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const path = Astro.url.pathname;
const active = (segment: string) => path.startsWith(base + segment);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · RSE CEP</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <slot name="head" />
  </head>
  <body>
    <header>
      <nav>
        <a href={base} class="site-title"><span>RSE</span><span class="wordmark-sep">·CEP</span></a>
        <input type="checkbox" id="nav-toggle" class="nav-checkbox" aria-hidden="true" />
        <label for="nav-toggle" class="nav-toggle" aria-label="Toggle navigation">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <rect y="3" width="20" height="2" rx="1"/>
            <rect y="9" width="20" height="2" rx="1"/>
            <rect y="15" width="20" height="2" rx="1"/>
          </svg>
        </label>
        <ul>
          <li><a href={`${base}team/`}     aria-current={active('team')     ? 'page' : undefined}>Team</a></li>
          <li><a href={`${base}blog/`}     aria-current={active('blog')     ? 'page' : undefined}>Blog</a></li>
          <li><a href={`${base}patterns/`} aria-current={active('patterns') ? 'page' : undefined}>Patterns</a></li>
          <li><a href={`${base}events/`}  aria-current={active('events')  ? 'page' : undefined}>Events</a></li>
          <li><a href={`${base}contact/`}  aria-current={active('contact')  ? 'page' : undefined}>Contact</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-logos">
          <a href="https://www.anu.edu.au/" target="_blank" rel="noopener" class="footer-logo-anu">
            <span class="powered-by">Powered by</span>
            <img src={`${base}ANU_Primary_Horizontal_GoldBlack.png`} alt="Australian National University" class="footer-logo" />
          </a>
          <a href="https://ardc.edu.au/" target="_blank" rel="noopener">
            <img src={`${base}ARDC_full.png`} alt="Australian Research Data Commons" class="footer-logo" />
          </a>
        </div>
        <p class="footer-acknowledgment">
          The Research Software Engineering Capacity Enhancement Project (RSE-CEP) is a co-investment
          partnership with the <a href="https://ardc.edu.au/">Australian Research Data Commons (ARDC)</a> through
          the HASS and Indigenous Research Data Commons (<a href="https://doi.org/10.3565/x5f6-mw53">DOI: 10.3565/x5f6-mw53</a>).
          The ARDC is enabled by the Australian Government's National Collaborative Research Infrastructure
          Strategy (NCRIS).
        </p>
        <p class="footer-small">
          Research Software Engineering Capacity Enhancement Project ·
          <a href="https://hdrh.anu.edu.au/">HASS Digital Research Hub, ANU</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  header {
    border-bottom: 1px solid var(--color-border);
    padding: 0.875rem 2rem;
    background: var(--color-bg);
  }

  nav {
    max-width: var(--content-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .site-title {
    display: flex;
    align-items: baseline;
    gap: 2px;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--color-text);
    flex-shrink: 0;
    text-decoration: none;
  }

  .site-title:hover {
    text-decoration: none;
    color: var(--color-text);
  }

  .wordmark-sep {
    font-weight: 300;
    color: var(--color-muted);
    letter-spacing: -0.025em;
  }

  .nav-checkbox {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .nav-toggle {
    display: none;
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.5rem;
  }

  nav ul a {
    color: var(--ink-600, var(--color-muted));
    font-size: 0.9rem;
    font-weight: 400;
    position: relative;
    padding-bottom: 2px;
  }

  nav ul a:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  nav ul a[aria-current="page"] {
    color: var(--color-text);
    font-weight: 500;
    text-decoration: none;
  }

  nav ul a[aria-current="page"]::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.875rem;
    height: 2px;
    background: var(--color-accent);
  }

  main {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  footer {
    border-top: 1px solid var(--color-border);
    padding: 2.5rem 2rem;
  }

  .footer-inner {
    max-width: var(--content-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .footer-logos {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .footer-logo-anu {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    text-decoration: none;
  }

  .powered-by {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .footer-logo {
    height: 40px;
    width: auto;
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    .footer-logo {
      filter: brightness(0) invert(1);
      opacity: 0.75;
    }
  }

  .footer-acknowledgment {
    font-size: 0.8rem;
    color: var(--color-muted);
    line-height: 1.65;
    max-width: 700px;
    margin: 0;
  }

  .footer-acknowledgment a {
    color: var(--color-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer-acknowledgment a:hover {
    color: var(--color-accent);
  }

  .footer-small {
    font-size: 0.75rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    letter-spacing: 0;
    margin: 0;
  }

  .footer-small a {
    color: var(--color-muted);
  }

  .footer-small a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    nav {
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0;
    }

    .nav-toggle {
      display: flex;
      align-items: center;
      cursor: pointer;
      padding: 0.5rem 0;
      color: var(--color-muted);
    }

    nav ul {
      display: none;
      width: 100%;
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 0;
      border-top: 1px solid var(--color-border);
    }

    .nav-checkbox:checked + .nav-toggle + ul {
      display: flex;
    }

    nav ul a {
      display: block;
      padding: 0.5rem 0;
    }

    nav ul a[aria-current="page"]::after {
      display: none;
    }
  }
</style>
